# Copy this file to terraform.tfvars and adjust as needed.
# terraform.tfvars itself is gitignored - never commit it.
# The Hetzner API token is NOT set here; export it as the HCLOUD_TOKEN
# environment variable instead (see README / infra/terraform/README.md).

server_name         = "news-checker"
location            = "fsn1"
server_type         = "cx23"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
allowed_ssh_cidrs   = ["0.0.0.0/0", "::/0"]
